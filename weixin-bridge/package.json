{
  "name": "weixin-bridge",
  "version": "0.1.0",
  "description": "微信通知桥：扫码登录个人微信机器人，把本地 HTTP 通知转发到微信（协议参考 @tencent-weixin/openclaw-weixin）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "login": "node dist/cli.js login",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0"
  }
}
